{
  "name": "dsh-roaming",
  "version": "0.4.1-framework.1",
  "description": "Roam your DSH sessions and memory across machines via a git repository.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./data": "./lib/portable-memory.js",
    "./sync": "./lib/memory-sync.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "MEMORY_FORMAT.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-sync",
    "memory",
    "cross-machine",
    "roaming",
    "git"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    },
    "manifestVersion": 1
  },
  "license": "MIT"
}
